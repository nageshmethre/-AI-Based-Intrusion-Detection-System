# Backend Dockerfile for AI-Based Suspicious Log Detector & SOC Platform
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY backend/requirements.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source code
COPY backend/ backend/
COPY ml/ ml/
COPY sample_data/ sample_data/

# Initialize and seed database, train initial models
RUN python -m backend.app.database.seed
RUN python ml/training/train.py && python ml/evaluation/evaluate.py

EXPOSE 8000

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
